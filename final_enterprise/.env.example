SOP_DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=your_database_name
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_RO_USER=your_readonly_user
MYSQL_RO_PASSWORD=your_readonly_password
MYSQL_HISTORY_TABLE=chat_messages
SOP_SALES_TABLE=sales_performance

SOP_AUTO_SEED=0
SOP_ASSUMED_TODAY=2026-04-12
SOP_SEED_DAYS=120
SOP_SEED_REGIONS=5
SOP_STORES_PER_REGION=12
SOP_SQL_MAX_ROWS=30
SOP_SQL_TIMEOUT_SECONDS=25
# 1=默认可用快路径时也先走 NL2SQL（由模型写 SQL）；0=简单问法可走本地快路径（省调用）
SOP_DATA_ANALYST_LLM_FIRST=1
# 1=uvicorn 日志里打印 data_analyst 各阶段耗时（排查卡顿）
SOP_DATA_ANALYST_TIMING=0
# 1=混合报告：先 NL 写 Markdown 草稿，第二次调用仅「草稿→JSON」再排版（JSON 成功率更高）；0=只调用一次
SOP_SYNTHESIS_TWO_STAGE_JSON=1
# 合成 LLM 单次请求 user 侧最大字符（含 JSON+RAG 摘录）；过小会截断坏 JSON 导致空回复
SOP_SYNTHESIS_MAX_USER_CHARS=28000
# 合成/总结用 LLM HTTP 超时（秒），长报告或慢网关建议 >=120
SOP_SYNTHESIS_TIMEOUT_SECONDS=120

OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=your_openai_base_url
OPENAI_MODEL=gpt-4o-mini

SCOPE_MIN_SCORE=0.18
ROUTE_MIN_DATA_SCORE=0.14
ROUTE_MIN_POLICY_SCORE=0.14
ROUTE_USE_LLM=0
ROUTE_SKIP_LLM_WHEN_CLEAR=1
ROUTE_LLM_MIN_CONFIDENCE=0.72
APPROVAL_USE_LLM_CLASSIFIER=0
POLICY_RETRIEVE_MIN_SCORE=0.07
POLICY_FAISS_K=8
POLICY_BM25_K=8
POLICY_ROUGH_K=12
POLICY_FINAL_K=4
POLICY_FAISS_WEIGHT=0.55
POLICY_BM25_WEIGHT=0.45
